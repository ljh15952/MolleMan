{
  "name": "MasterMap2 Web",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "hostRequirements": {
    "memory": "4gb"
  },
  // 최초 생성 시 1회: 의존성, Chromium, 시스템 라이브러리, 한·중·일 폰트 설치
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // VS Code가 연결될 때마다 서버 실행(이미 실행 중이면 그냥 종료)
  "postAttachCommand": {
    "server": "npm start"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "MasterMap2",
      "onAutoForward": "openBrowser"
    }
  }
}
